    <string name="diag_dialog_close">Got it</string>
    <string name="diag_dialog_overlay_body">You can grant it directly on the watch with local ADB in Settings, or run in your terminal:\n\nadb shell appops set com.aaronhrndz.ultraremapper SYSTEM_ALERT_WINDOW allow</string>
    <string name="diag_dialog_secure_body">You can grant it directly on the watch with local ADB in Settings, or run in your terminal:\n\nadb shell pm grant com.aaronhrndz.ultraremapper android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="diag_dialog_route_body">To route the Action button to Ultra Remapper, go to:\n\nWatch Settings › Buttons &amp; Gestures › Action Button › Choose Ultra Remapper\n\nOr via ADB:\nadb shell settings put global setting_action_button_press com.aaronhrndz.ultraremapper/com.aaronhrndz.ultraremapper.ActionButtonService</string>
    <string name="diag_dialog_media_body">You can grant it directly on the watch with local ADB in Settings, or run in your terminal:\n\nadb shell cmd notification allow_listener com.aaronhrndz.ultraremapper/com.aaronhrndz.ultraremapper.MediaControlService</string>
